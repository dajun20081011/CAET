# ============================================================
# CAET 后端环境变量（生产部署请改为真实值，勿提交真实 .env）
# ============================================================

# 数据库连接（PostgreSQL，使用独立 database + 独立 user，与 Cabin Voice 隔离）
# 异步驱动：
DATABASE_URL=
# 如后端用同步驱动，可改为：
# DATABASE_URL=

# JWT 配置
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS：前端域名（Nginx 代理后的真实来源）
CORS_ORIGINS=https://crew.cabinvoice.cn

# 首次部署初始化管理员（执行后可注释/删除，避免重复创建）
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=
INIT_ADMIN_NAME=管理员

# 上传目录（音频等静态资源），相对或绝对路径均可
UPLOAD_DIR=./uploads

# 服务监听（systemd / gunicorn 启动时读取；端口不写死，可改，但需与下方保持一致）
# ⚠️ 若修改 PORT，必须同步：
#   1) Nginx caet.conf 中 upstream caet_backend 的端口
#   2) 部署前冲突检查脚本 presetup_check.sh 的 --port 参数（如手动指定）
#   3) Docker 运行映射端口（如使用容器）
HOST=0.0.0.0
PORT=8000
