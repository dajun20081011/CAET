# ============================================================
# CAET 统一训练平台 — 环境变量示例（Docker / 本地通用）
# 复制为 .env 后修改；.env 不入库（见 .gitignore）。
# 生产务必修改 SECRET_KEY / POSTGRES_PASSWORD / 管理员密码。
# ============================================================

# ---------- PostgreSQL（docker-compose 服务名 caet-postgres） ----------
POSTGRES_PASSWORD=
# DATABASE_URL 由 docker-compose 使用 POSTGRES_PASSWORD 组装；本地开发时再显式填写。
DATABASE_URL=

# ---------- Redis（docker-compose 服务名 caet-redis，轻量接入） ----------
REDIS_URL=redis://caet-redis:6379/0

# ---------- JWT ----------
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS：前端对外访问地址（HTTPS 域名），逗号分隔 ----------
CORS_ORIGINS=https://crew.cabinvoice.cn

# ---------- 首次部署初始化管理员 ----------
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=
INIT_ADMIN_NAME=管理员

# ---------- 上传目录（容器内挂载卷） ----------
UPLOAD_DIR=/app/uploads

# ---------- 服务监听（容器内） ----------
HOST=0.0.0.0
PORT=8000

# ---------- 缓存 TTL（秒，Redis 轻量缓存用） ----------
CACHE_TTL_SECONDS=300

# ---------- 前端对外发布端口 ----------
CAET_HTTP_PORT=80
CAET_HTTPS_PORT=443
